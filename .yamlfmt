# yamlfmt (in the flake dev shell): `yamlfmt` formats, `yamlfmt -lint` checks.
exclude:
  - themes/  # vendored from HACS; yamlfmt matches directories by prefix, not with **
  - automations.yaml  # these three are written by HA's UI editors
  - scripts.yaml
  - scenes.yaml
formatter:
  type: basic
  retain_line_breaks_single: true
  scan_folded_as_literal: true
  trim_trailing_whitespace: true
  eof_newline: true
  drop_merge_tag: true
  pad_line_comments: 2
