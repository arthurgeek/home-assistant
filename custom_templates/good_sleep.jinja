{#- Samsung Good Sleep sessions, for the countdown on the AC cards. -#}

{#- The level (half hours) after adding `hours` to the session ending at `end`: what's left, rounded up, plus the
    extra; at most 24. Empty without a session. -#}
{%- macro good_sleep_extended_level(end, now, hours) -%}
  {%- if end -%}
    {%- set left = [((as_datetime(end) - now).total_seconds() / 1800) | round(0, 'ceil') | int, 0] | max -%}
    {{- [left + (((hours | float(0)) * 2) | round(0, 'ceil') | int), 24] | min -}}
  {%- endif -%}
{%- endmacro -%}
